{
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "*"
  ],
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "Endpoints": {
      "HTTPS": {
        "Url": "https://localhost:5001"
      },
      "HTTP": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "use_builtin_ratelimiter": false
  },
  "Core": {
    "disable_full_mesh_check": false,
    "use_os_cert_store": true,
    "cert_pem_path": null,
    "cert_key_path": null
  },
  "JwtSettings": {
    "Key": "TODO_CHANGE_ME",
    "Issuer": "YourIssuer",
    "Audience": "YourAudience",
    "ExpiresInMinutes_Session": 15,
    "ExpiresInMinutes_Refresh": 43200,
    "enforce_ip_match": false
  },
  "API": {
    "keys": []
  },
  "Monitor": {
    "username": null,
    "password": null
  },
  "Middleware": {
    "jwks_endpoint": null,
    "audience": null,
    "issuer": null
  },
  "Database": {
    "db_host": "localhost",
    "db_port": 3306,
    "db_name": "dbname",
    "db_username": "dbuser",
    "db_password": "dbpassword",
    "db_connect_timeout": 10,
    "db_command_timeout": 10
  },
  "TURN": {
    "api_base_url": "https://rtc.live.cloudflare.com/v1/turn/keys",
    "key": null,
    "token": null,
    "token_ttl": -1,
    "automatic_token_invalidate": false
  },
  "Discord": {
    "enable_discord": false,
    "token": null,
    "send_room_chat_to_discord": false,
    "discord_network_room_chat_channel": 0,
    "discord_admin_commands_channel": 0,
    "discord_admins": []
  },
  "MatchData": {
    "upload_match_data": false,
    "require_upload_confirmation": false,
    "upload_confirmation_key": null,
    "s3_endpoint": null,
    "s3_region": "us-east-1",
    "s3_bucket_name": null,
    "s3_access_key": null,
    "s3_secret_key": null,
    "s3_url_ttl_minutes": 60
  },
  "ExternalLeaderboards": {
    "PostUrl": null,
    "PostToken": null,
    "GetUrl": null,
    "GetToken": null
  },
  "Sentry": {
    "enabled": false,
    "dsn": "",
    "environment": "production"
  }
}
